  state.picked.forEach(v=>{
    const item = document.createElement('div');
    item.className = 'narrow-item';
    if(state.narrowed.includes(v)) item.classList.add('selected');
    item.innerHTML = `<span class="narrow-item-name">${v}</span>
      <span class="narrow-check"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#1D1311" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>`;
    item.addEventListener('click', ()=>toggleNarrow(v));
    list.appendChild(item);
  });
  updateNarrowCounter();
}
function toggleNarrow(v){
  const idx = state.narrowed.indexOf(v);
  if(idx>-1){
    state.narrowed.splice(idx,1);
  } else if(state.narrowed.length<5){
    state.narrowed.push(v);
