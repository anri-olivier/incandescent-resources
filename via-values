/* ============ STEP 5: SENTENCE BUILDER LIVE PREVIEW ============ */
function wireFormula(prefix, fields, template, outputId){
  const inputs = fields.map(f=>document.getElementById(prefix+'-'+f));
  function update(){
    const vals = inputs.map(i=>i.value.trim());
    if(vals.every(v=>v==='')){
      document.getElementById(outputId).innerHTML = `<span class="placeholder">Your sentence will appear here as you type.</span>`;
      return;
    }
    let sentence = template;
    fields.forEach((f,i)=>{
      const ph = '['+ (vals[i] || ('___')) +']';
      sentence = sentence.replace('{'+f+'}', vals[i] ? `<strong>${escapeHtml(vals[i])}</strong>` : `<span class="placeholder">[${f}]</span>`);
    });
    document.getElementById(outputId).innerHTML = sentence;
  }
  inputs.forEach(i=>i.addEventListener('input', update));
}
function escapeHtml(s){
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

