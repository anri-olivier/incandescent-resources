<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Discover Your Values | Olivier Expressions</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400&family=Montserrat:wght@400;500;600;700&family=Dancing+Script:wght@600&display=swap');

  :root{
    --ivory:#F7F6F2;
    --ivory-deep:#F0EEE7;
    --espresso:#1D1311;
    --gold:#B8A050;
    --gold-soft:#D8C98A;
    --forest:#203226;
    --line:#E3DFD3;
    --white:#FFFFFF;
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--ivory);
    color:var(--espresso);
    font-family:'Montserrat',sans-serif;
    -webkit-font-smoothing:antialiased;
    line-height:1.6;
  }

  .wrap{
    max-width:760px;
    margin:0 auto;
    padding:48px 24px 100px;
  }

  /* ---------- Header ---------- */
  .crest{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    margin-bottom:18px;
  }
  .crest svg{width:26px;height:26px;}

  .eyebrow{
    text-align:center;
    font-family:'Dancing Script',cursive;
    color:var(--gold);
    font-size:24px;
    margin:0 0 2px;
  }
  h1{
    text-align:center;
    font-family:'Playfair Display',serif;
    font-weight:400;
    font-size:38px;
    letter-spacing:0.5px;
    margin:0 0 6px;
    text-transform:capitalize;
  }
  .subhead{
    text-align:center;
    font-size:14px;
    color:#5b5650;
    max-width:480px;
    margin:0 auto 36px;
  }

  .divider{
    width:64px;
    height:1.5px;
    background:var(--gold);
    margin:0 auto 36px;
  }

  /* ---------- Progress ---------- */
  .progress-rail{
    display:flex;
    justify-content:center;
    gap:8px;
    margin-bottom:40px;
  }
  .progress-dot{
    width:8px;height:8px;border-radius:50%;
    background:var(--line);
    transition:background .3s, transform .3s;
  }
  .progress-dot.active{background:var(--gold); transform:scale(1.3);}
  .progress-dot.done{background:var(--forest);}

  /* ---------- Card / Step ---------- */
  .step{display:none;}
  .step.active{display:block; animation:fade .4s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

  .card{
    background:var(--white);
    border:1px solid var(--line);
    border-radius:14px;
    padding:34px 30px;
    margin-bottom:24px;
  }

  .step-label{
    font-family:'Eyesome Script','Dancing Script',cursive;
    color:#1D1311;
    font-size:33px;
    display:block;
    margin-bottom:2px;
  }
  .step-title{
    font-family:'Playfair Display',serif;
    font-weight:400;
    font-size:26px;
    margin:0 0 10px;
  }
  .step-instructions{
    font-size:14px;
    color:#5b5650;
    margin-bottom:24px;
  }

  /* ---------- Step 1: value picker ---------- */
  .counter{
    text-align:center;
    font-size:13px;
    font-weight:600;
    letter-spacing:0.5px;
    color:var(--forest);
    background:var(--ivory-deep);
    border-radius:30px;
    padding:8px 14px;
    margin-bottom:22px;
    display:inline-block;
  }
  .counter-wrap{text-align:center;}

  .value-grid{
    display:flex;
    flex-wrap:wrap;
    gap:9px;
    justify-content:center;
    margin-bottom:22px;
  }
  .value-chip{
    border:1.5px solid var(--line);
    background:var(--ivory);
    color:var(--espresso);
    border-radius:30px;
    padding:8px 16px;
    font-size:13px;
    font-weight:500;
    cursor:pointer;
    transition:all .15s ease;
    user-select:none;
  }
  .value-chip:hover{border-color:var(--gold-soft);}
  .value-chip.selected{
    background:var(--gold);
    border-color:var(--gold);
    color:var(--espresso);
    font-weight:600;
  }
  .value-chip.disabled{
    opacity:0.35;
    cursor:not-allowed;
  }

  .custom-add{
    display:flex;
    gap:8px;
    max-width:420px;
    margin:0 auto 8px;
  }
  .custom-add input{
    flex:1;
    border:1.5px solid var(--line);
    border-radius:30px;
    padding:10px 16px;
    font-family:'Montserrat',sans-serif;
    font-size:13px;
    background:var(--ivory);
    color:var(--espresso);
  }
  .custom-add input:focus{outline:none; border-color:var(--gold);}
  .custom-add button{
    border-radius:30px;
    border:1.5px solid var(--gold);
    background:transparent;
    color:var(--gold);
    padding:10px 18px;
    font-family:'Montserrat',sans-serif;
    font-weight:600;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.5px;
    cursor:pointer;
  }
  .custom-add button:hover{background:var(--gold); color:var(--espresso);}
  .hint{font-size:12px; color:#8a8478; text-align:center; margin-top:4px;}

  /* ---------- Step 2: narrow to top values ---------- */
  .narrow-list{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-bottom:8px;
  }
  .narrow-item{
    display:flex;
    align-items:center;
    justify-content:space-between;
    border:1.5px solid var(--line);
    border-radius:10px;
    padding:14px 18px;
    background:var(--ivory);
    cursor:pointer;
    transition:all .15s ease;
  }
  .narrow-item:hover{border-color:var(--gold-soft);}
  .narrow-item.selected{
    border-color:var(--gold);
    background:#FBF8EE;
  }
  .narrow-item-name{font-weight:600; font-size:15px;}
  .narrow-check{
    width:20px;height:20px;border-radius:50%;
    border:1.5px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .narrow-item.selected .narrow-check{
    background:var(--gold); border-color:var(--gold);
  }
  .narrow-check svg{width:11px;height:11px; display:none;}
  .narrow-item.selected .narrow-check svg{display:block;}

  /* ---------- Step 3: journal prompts ---------- */
  .value-block{
    border:1.5px solid var(--line);
    border-radius:14px;
    padding:26px 26px 14px;
    margin-bottom:22px;
    background:var(--white);
  }
  .value-block-title{
    font-family:'Playfair Display',serif;
    font-size:21px;
    font-weight:400;
    color:var(--forest);
    margin:0 0 4px;
    text-transform:capitalize;
  }
  .value-block-sub{
    font-size:12px;
    color:#B8A050;
    font-weight:700;
    margin-bottom:18px;
  }
  .prompt-q{
    font-size:13px;
    font-weight:600;
    margin-bottom:6px;
    color:var(--espresso);
  }
  .prompt-group{margin-bottom:18px;}
  textarea{
    width:100%;
    border:1.5px solid var(--line);
    border-radius:8px;
    padding:12px 14px;
    font-family:'Montserrat',sans-serif;
    font-size:13px;
    color:var(--espresso);
    background:var(--ivory);
    resize:vertical;
    min-height:54px;
  }
  textarea:focus{outline:none; border-color:var(--gold);}

  /* ---------- Step 4: confirm ---------- */
  .confirm-pills{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    justify-content:center;
    margin-bottom:8px;
  }
  .confirm-pill{
    background:var(--forest);
    color:var(--ivory);
    border-radius:30px;
    padding:10px 20px;
    font-size:14px;
    font-weight:600;
    text-transform:capitalize;
  }

  /* ---------- Step 5: sentence builder ---------- */
  .formula-card{
    border:1.5px solid var(--line);
    border-radius:14px;
    padding:24px 26px;
    margin-bottom:20px;
    background:var(--white);
  }
  .formula-eyebrow{
    font-family:'Eyesome Script','Dancing Script',cursive;
    color:var(--gold);
    font-size:16px;
    margin-bottom:2px;
    display:block;
  }
  .formula-title{
    font-family:'Playfair Display',serif;
    font-weight:400;
    font-size:20px;
    margin:0 0 10px;
  }
  .formula-template{
    font-size:13px;
    font-style:italic;
    color:#5b5650;
    background:var(--ivory-deep);
    border-radius:8px;
    padding:12px 16px;
    margin-bottom:16px;
  }
  .formula-fields{
    display:flex;
    flex-direction:column;
    gap:12px;
    margin-bottom:16px;
  }
  .formula-field label{
    display:block;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.5px;
    color:var(--forest);
    margin-bottom:5px;
  }
  .formula-field input{
    width:100%;
    border:1.5px solid var(--line);
    border-radius:8px;
    padding:10px 14px;
    font-family:'Montserrat',sans-serif;
    font-size:13px;
    background:var(--ivory);
    color:var(--espresso);
  }
  .formula-field input:focus{outline:none; border-color:var(--gold);}
  .formula-output{
    background:#FBF8EE;
    border-left:3px solid var(--gold);
    padding:14px 18px;
    font-family:'Playfair Display',serif;
    font-size:16px;
    color:var(--espresso);
    border-radius:0 8px 8px 0;
  }
  .formula-output .placeholder{color:#b0aa9c; font-style:italic; font-family:'Montserrat',sans-serif; font-size:13px;}

  /* ---------- Nav buttons ---------- */
  .nav-row{
    display:flex;
    justify-content:space-between;
    gap:12px;
    margin-top:8px;
  }
  .btn{
    border-radius:8px;
    padding:13px 28px;
    font-family:'Montserrat',sans-serif;
    font-weight:600;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.6px;
    cursor:pointer;
    border:none;
    transition:opacity .15s ease, transform .1s ease;
  }
  .btn:active{transform:scale(0.98);}
  .btn-primary{background:var(--gold); color:var(--espresso);}
  .btn-primary:disabled{opacity:0.4; cursor:not-allowed;}
  .btn-ghost{background:transparent; color:var(--gold); border:1.5px solid var(--gold);}
  .btn-ghost:disabled{opacity:0.3; cursor:not-allowed;}
  .btn-full{width:100%;}

  /* ---------- Final / download ---------- */
  .final-card{
    text-align:center;
    padding:46px 30px;
  }
  .final-icon{margin-bottom:14px;}
  .final-via{
    display:flex;
    justify-content:center;
    gap:18px;
    margin:28px 0;
    flex-wrap:wrap;
  }
  .final-via-item{
    flex:1;
    min-width:140px;
    border:1.5px solid var(--line);
    border-radius:12px;
    padding:18px 14px;
  }
  .final-via-item h4{
    font-family:'Playfair Display',serif;
    font-weight:400;
    font-size:13px;
    color:var(--gold);
    text-transform:uppercase;
    letter-spacing:1px;
    margin:0 0 10px;
  }
  .final-via-item p{font-size:22px; margin:0; color:var(--espresso); font-family:'Playfair Display',serif; font-weight:400; text-transform:capitalize;}

  /* ---------- PDF document (hidden, rendered for export) ---------- */
  #pdf-doc{position:absolute; left:-9999px; top:0; width:700px; background:var(--ivory);}
  .pdf-page{padding:50px 50px 40px; background:var(--ivory); page-break-after:always;}
  .pdf-header{text-align:center; margin-bottom:30px;}
  .pdf-header .eyebrow{font-size:20px;}
  .pdf-header h1{font-size:30px;}
  .pdf-section-title{
    font-family:'Playfair Display',serif;
    font-size:20px;
    color:var(--forest);
    border-bottom:1.5px solid var(--gold);
    padding-bottom:8px;
    margin:30px 0 16px;
    text-transform:capitalize;
  }
  .pdf-q{font-size:12px; font-weight:700; margin:14px 0 4px;}
  .pdf-a{font-size:12px; color:#3a352f; margin:0 0 6px; padding-left:2px; border-left:2px solid var(--line); padding-left:10px; min-height:14px;}
  .pdf-formula-title{font-family:'Playfair Display',serif; font-size:16px; color:var(--gold); margin:24px 0 6px;}
  .pdf-formula-sentence{font-family:'Playfair Display',serif; font-size:18px; line-height:1.5; background:#FBF8EE; border-left:3px solid var(--gold); padding:16px 20px; border-radius:0 8px 8px 0;}
  .pdf-footer{text-align:center; font-size:10px; color:#8a8478; margin-top:50px;}

  @media(max-width:560px){
    .wrap{padding:32px 16px 90px;}
    h1{font-size:30px;}
    .card{padding:26px 18px;}
    .final-via{flex-direction:column;}
  }
</style>
</head>
<body>

<div class="wrap">

  <div class="crest">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2L13.8 9.2L21 11L13.8 12.8L12 20L10.2 12.8L3 11L10.2 9.2L12 2Z" fill="#B8A050"/>
    </svg>
  </div>
  <p class="eyebrow">self discovery</p>
  <h1>Find Your Core Values</h1>
  <p class="subhead">A guided journey to name what matters most to you, and shape it into words you can live by.</p>
  <div class="divider"></div>

  <div class="progress-rail" id="progressRail"></div>

  <!-- STEP 1: PICK 6 -->
  <div class="step active" data-step="1">
    <div class="card">
      <span class="step-label">step one</span>
      <h2 class="step-title">Choose Six Values</h2>
      <p class="step-instructions">Scan the words below. Click any that pop out for you, the ones that feel true without overthinking. You can also add your own. Choose 5 to 10.</p>
      <div class="counter-wrap"><span class="counter" id="pickCounter">0 of 10 selected</span></div>
      <div class="custom-add">
        <input type="text" id="customValueInput" placeholder="Add your own value..." maxlength="24">
        <button id="addCustomBtn">Add</button>
      </div>
      <p class="hint" id="addHint" style="visibility:hidden;">Select 5 to 10 values, or type your own.</p>
      <div class="value-grid" id="valueGrid"></div>
      <div class="nav-row">
        <span></span>
        <button class="btn btn-primary" id="step1Next" disabled>Continue</button>
      </div>
    </div>
  </div>

  <!-- STEP 2: NARROW TO TOP 2-4 -->
  <div class="step" data-step="2">
    <div class="card">
      <span class="step-label">step two</span>
      <h2 class="step-title">Narrow to Your Top Values</h2>
      <p class="step-instructions">Look at the values you chose. Which ones are actually so alike and similar, which ones completely stand on their own? Compare them against each other until only your truest remain. Choose 3 to 5.</p>
      <div class="counter-wrap"><span class="counter" id="narrowCounter">0 of 5 selected</span></div>
      <div class="narrow-list" id="narrowList"></div>
      <div class="nav-row">
        <button class="btn btn-ghost" data-back="1">Back</button>
        <button class="btn btn-primary" id="step2Next" disabled>Continue</button>
      </div>
    </div>
  </div>

  <!-- STEP 3: JOURNAL PROMPTS -->
  <div class="step" data-step="3">
    <span class="step-label" style="display:block;text-align:center;">step three</span>
    <h2 class="step-title" style="text-align:center;">Get Clarity</h2>
    <p class="step-instructions" style="text-align:center; max-width:520px; margin-left:auto; margin-right:auto;">This piece is optional, but it helps you remember why you chose it, when you use it, and why you stand by it.</p>
    <div id="journalContainer"></div>
    <div class="nav-row">
      <button class="btn btn-ghost" data-back="2">Back</button>
      <button class="btn btn-primary" id="step3Next">Continue</button>
    </div>
  </div>

  <!-- STEP 4: CONFIRM -->
  <div class="step" data-step="4">
    <div class="card" style="text-align:center;">
      <span class="step-label">step four</span>
      <h2 class="step-title">Confirm Your Values</h2>
      <p class="step-instructions">After reflecting, these are the values most true to you right now. Ready to move forward with these?</p>
      <div class="confirm-pills" id="confirmPills"></div>
      <p class="hint" style="margin-top:18px;">If something shifted while journaling, go back and adjust.</p>
      <div class="nav-row">
        <button class="btn btn-ghost" data-back="3">Back</button>
        <button class="btn btn-primary" id="step4Next">Yes, These Are Mine</button>
      </div>
    </div>
  </div>

  <!-- STEP 5: SENTENCE BUILDER -->
  <div class="step" data-step="5">
    <span class="step-label" style="display:block;text-align:center;">step five</span>
    <h2 class="step-title" style="text-align:center;">Put Your Values Into Words</h2>
    <p class="step-instructions" style="text-align:center; max-width:520px; margin-left:auto; margin-right:auto;">A value only changes you when it is specific. Complete each formula below to turn your values into a statement you can return to.</p>

    <div class="formula-card">
      <span class="formula-eyebrow">the professional / career focus</span>
      <h3 class="formula-title">Career &amp; Work</h3>
      <p class="formula-template">I value [Quality] through [Specific Action] in order to [Impact].</p>
      <div class="formula-fields">
        <div class="formula-field"><label>Quality</label><input type="text" id="f1-quality" placeholder="e.g. Excellence"></div>
        <div class="formula-field"><label>Specific Action</label><input type="text" id="f1-action" placeholder="e.g. delivering work I'm proud to put my name on"></div>
        <div class="formula-field"><label>Impact</label><input type="text" id="f1-impact" placeholder="e.g. build a business that reflects who I am"></div>
      </div>
      <div class="formula-output" id="f1-output"><span class="placeholder">Your sentence will appear here as you type.</span></div>
    </div>

    <div class="formula-card">
      <span class="formula-eyebrow">the personal growth focus</span>
      <h3 class="formula-title">Personal Growth</h3>
      <p class="formula-template">I value [Virtue] as embodied through my [Habit/Choice] because [Reason].</p>
      <div class="formula-fields">
        <div class="formula-field"><label>Virtue</label><input type="text" id="f2-virtue" placeholder="e.g. Discipline"></div>
        <div class="formula-field"><label>Habit / Choice</label><input type="text" id="f2-habit" placeholder="e.g. showing up for myself before anyone else"></div>
        <div class="formula-field"><label>Reason</label><input type="text" id="f2-reason" placeholder="e.g. I deserve the same devotion I give everyone else"></div>
      </div>
      <div class="formula-output" id="f2-output"><span class="placeholder">Your sentence will appear here as you type.</span></div>
    </div>

    <div class="formula-card">
      <span class="formula-eyebrow">the relationship / community focus</span>
      <h3 class="formula-title">Relationships &amp; Community</h3>
      <p class="formula-template">I value [Core Belief] through [Daily/Weekly Behavior] so that [Group/Person] feels [Emotion/State].</p>
      <div class="formula-fields">
        <div class="formula-field"><label>Core Belief</label><input type="text" id="f3-belief" placeholder="e.g. Belonging"></div>
        <div class="formula-field"><label>Daily / Weekly Behavior</label><input type="text" id="f3-behavior" placeholder="e.g. checking in with the women in my community"></div>
        <div class="formula-field"><label>Group / Person</label><input type="text" id="f3-group" placeholder="e.g. my clients"></div>
        <div class="formula-field"><label>Emotion / State</label><input type="text" id="f3-emotion" placeholder="e.g. seen and supported"></div>
      </div>
      <div class="formula-output" id="f3-output"><span class="placeholder">Your sentence will appear here as you type.</span></div>
    </div>

    <div class="nav-row">
      <button class="btn btn-ghost" data-back="4">Back</button>
      <button class="btn btn-primary" id="step5Next">Continue</button>
    </div>
  </div>

  <!-- STEP 6: FINAL / DOWNLOAD -->
  <div class="step" data-step="6">
    <div class="card final-card">
      <div class="final-icon">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L13.8 9.2L21 11L13.8 12.8L12 20L10.2 12.8L3 11L10.2 9.2L12 2Z" fill="#B8A050"/>
        </svg>
      </div>
      <span class="step-label">they've been chosen</span>
      <h2 class="step-title">Your Values, Named</h2>
      <p class="step-instructions">This is who you are when you are most yourself. Keep it close. Let it guide the next decision you make.</p>
      <div class="final-via" id="finalSummary"></div>
      <button class="btn btn-primary btn-full" id="downloadBtn">Download My Values (PDF)</button>
      <p class="hint" id="downloadStatus" style="margin-top:12px;"></p>
    </div>
  </div>

</div>

<!-- Hidden PDF render target -->
<div id="pdf-doc"></div>

<script>
/* ============ DATA ============ */
const VALUES_LIST = [
"Accountability","Adaptability","Altruism","Assertiveness","Awareness","Balance","Boldness","Calm",
"Candor","Charity","Common Sense","Compassion","Confidence","Connection","Consistency","Conviction",
"Cooperation","Courage","Courtesy","Craftsmanship","Creativity","Curiosity","Decisiveness","Dependability",
"Discipline","Diversity","Drive","Efficiency","Empathy","Enthusiasm","Equality","Excellence","Fairness",
"Fidelity","Freedom","Fun","Generosity","Gratitude","Happiness","Harmony","Health","Honesty","Honor",
"Hope","Hospitality","Humility","Humor","Inclusion","Individuality","Innovation","Inspiring","Integrity",
"Intelligence","Justice","Kindness","Leadership","Learning","Logic","Love","Loyalty","Openness","Optimism",
"Passion","Patience","Persistence","Playfulness","Purpose","Realistic","Respect","Responsibility","Security",
"Self-Reliance","Selfless","Service","Stewardship","Teamwork","Tolerance","Transparency","Trust",
"Trustworthy","Understanding","Unity","Forgiveness","Self-Awareness","Authenticity","Ambition","Independence"
];

const JOURNAL_BANK = {
"honesty":["What does honesty mean to you?","How important is being truthful in your daily life?","How does honesty affect your relationships?","Can honesty coexist with kindness?"],
"trust":["What does trust mean to you in a relationship?","How do you build trust with others?","How do you know when to trust someone?","What actions demonstrate trust to you?"],
