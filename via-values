const GENERIC_PROMPTS = (val)=>[
`What does ${val} mean to you, in your own words?`,
`Describe a recent moment when you lived out ${val}. How did it feel?`,
`Where in your life do you feel you are not yet honoring ${val}?`,
`If ${val} guided every decision this month, what would change?`
];

function getPrompts(val){
  const key = val.toLowerCase().trim();
  return JOURNAL_BANK[key] || GENERIC_PROMPTS(val);
}

/* ============ STATE ============ */
let state = {
  picked: [],        // up to 6
  customAdds: [],
  narrowed: [],       // 2-4
  journal: {},         // { value: [a1,a2,a3,a4] }
  currentStep: 1
};

/* ============ RENDER: STEP 1 ============ */
const valueGrid = document.getElementById('valueGrid');
function renderValueGrid(){
  valueGrid.innerHTML = '';
  const allValues = [...VALUES_LIST, ...state.customAdds];
  allValues.forEach(v=>{
    const chip = document.createElement('div');
    chip.className = 'value-chip';
    chip.textContent = v;
    if(state.picked.includes(v)) chip.classList.add('selected');
    if(!state.picked.includes(v) && state.picked.length>=10) chip.classList.add('disabled');
    chip.addEventListener('click', ()=>toggleValue(v));
    valueGrid.appendChild(chip);
  });
  updatePickCounter();
}

function toggleValue(v){
  const idx = state.picked.indexOf(v);
  if(idx>-1){
    state.picked.splice(idx,1);
  } else if(state.picked.length<10){
    state.picked.push(v);
  }
  renderValueGrid();
}

function updatePickCounter(){
  document.getElementById('pickCounter').textContent = `${state.picked.length} of 10 selected`;
  document.getElementById('step1Next').disabled = state.picked.length < 5;
}

document.getElementById('addCustomBtn').addEventListener('click', addCustomValue);
document.getElementById('customValueInput').addEventListener('keydown', e=>{
  if(e.key==='Enter'){ e.preventDefault(); addCustomValue(); }
});
function addCustomValue(){
  const input = document.getElementById('customValueInput');
  let val = input.value.trim();
  if(!val) return;
  val = val.charAt(0).toUpperCase()+val.slice(1);
  if(![...VALUES_LIST, ...state.customAdds].includes(val)){
    state.customAdds.push(val);
  }
  if(state.picked.length<10 && !state.picked.includes(val)){
    state.picked.push(val);
  }
  input.value='';
  renderValueGrid();
}

document.getElementById('step1Next').addEventListener('click', ()=>{
