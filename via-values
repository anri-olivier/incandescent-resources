function renderJournal(){
  const container = document.getElementById('journalContainer');
  container.innerHTML = '';
  state.narrowed.forEach(v=>{
    if(!state.journal[v]) state.journal[v] = ['','','',''];
    const prompts = getPrompts(v);
    const block = document.createElement('div');
    block.className = 'value-block';
    let html = `<h3 class="value-block-title">${v}</h3><p class="value-block-sub">Take your time with each one.</p>`;
    prompts.forEach((q,i)=>{
      html += `<div class="prompt-group">
        <p class="prompt-q">${i+1}. ${q}</p>
        <textarea data-value="${v}" data-idx="${i}" placeholder="Your answer...">${state.journal[v][i]||''}</textarea>
      </div>`;
    });
    block.innerHTML = html;
    container.appendChild(block);
  });
  container.querySelectorAll('textarea').forEach(t=>{
    t.addEventListener('input', e=>{
      const v = e.target.dataset.value;
      const i = parseInt(e.target.dataset.idx);
      state.journal[v][i] = e.target.value;
    });
  });
}

